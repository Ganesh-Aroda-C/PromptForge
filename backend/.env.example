# PromptForge AI Environment Configuration

# Core App Configuration
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Configuration
# If MongoDB is unavailable, the application automatically uses local persistent JSON storage.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=promptforge_ai

# Live AI Mode Providers (Optional - App falls back to high-fidelity Demo / Heuristic Mode if omitted)
# LLM Provider: "mock", "gemini", "openai", "huggingface"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Diffusion Provider: "demo", "diffusers", "huggingface", "openai"
DIFFUSION_PROVIDER=demo
DIFFUSION_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Evaluation Provider: "heuristic", "blip", "clip", "api"
EVALUATION_PROVIDER=heuristic

# Storage paths
STORAGE_DIR=backend/data/storage
UPLOAD_DIR=backend/data/uploads
